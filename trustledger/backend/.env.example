# Copy this file to .env and fill in real values. Never commit .env itself
# (it's in .gitignore) — this template file IS meant to be committed.
#
# See docs/BACKEND_SPEC.md "Environment / connection assumptions" for the
# full explanation of each variable, especially the distinction between
# RELAYER_PRIVATE_KEY and BACKEND_SIGNING_PRIVATE_KEY — they are NOT
# interchangeable and serve completely different purposes.

# --- Blockchain connection ---
HARDHAT_RPC_URL=http://127.0.0.1:8545

# Filled in after running `npx hardhat run scripts/deploy.js --network localhost`
# in the contracts/ directory — copy the three printed addresses here.
IDENTITY_REGISTRY_ADDRESS=
ACCESS_CONTROL_ADDRESS=
ASSET_REGISTRY_ADDRESS=

# --- Relayer key (REAL blockchain account key) ---
# Used to sign EVERY state-changing contract transaction this backend
# submits. For local dev, use one of the funded Hardhat local accounts
# printed by `npx hardhat node` (e.g. Account #0's private key) — this
# should be the SAME address that was used as the deployer/bootstrap
# Admin, so relayed privileged writes succeed at the contract level.
# See BACKEND_SPEC.md "Authorization Trust Boundary" for what this key
# does and does NOT guarantee.
RELAYER_PRIVATE_KEY=

# --- Backend's own signing key (NOT a blockchain key) ---
# Used ONLY for JWT signing and proof-bundle signing. Never touches the
# chain. Must be different from RELAYER_PRIVATE_KEY above. For local dev,
# any sufficiently random hex string works — this does not need to be a
# real Ethereum private key, though using one (e.g. via `openssl rand
# -hex 32`) is a convenient way to generate a random value of the right
# shape.
BACKEND_SIGNING_PRIVATE_KEY=

# --- Document encryption master key ---
# Used ONLY to wrap/unwrap per-asset data encryption keys. See
# BACKEND_SPEC.md "Key Management" section. Generate with, e.g.:
#   openssl rand -hex 32
DOCUMENT_MASTER_KEY=

# --- Database ---
DATABASE_URL=postgresql://trustledger:trustledger@localhost:5432/trustledger

# --- Server ---
PORT=3000

# --- Auth domain (used in the challenge-response signable message) ---
# See BACKEND_SPEC.md "Flow" — this is the fixed, server-configured
# domain string included in every authentication challenge, for domain
# separation. Not client-supplied.
AUTH_DOMAIN=trustledger.local


FRONTEND_ORIGIN=http://localhost:5173

# --- JWT signing secret (OWASP: separate from proof-bundle key) ---
# Defaults to BACKEND_SIGNING_PRIVATE_KEY if not set, for backward
# compatibility. Set explicitly to decouple JWT signing from proof-
# bundle signing. Generate with: openssl rand -hex 32
JWT_SECRET=

# --- JWT key rotation (OWASP: zero-downtime rotation) ---
# When rotating JWT_SECRET, set JWT_SECRET_PREVIOUS to the OLD value.
# The backend will try the new key first, then fall back to the old key
# for tokens issued before rotation. After all old JWTs expire (15 min),
# remove this variable.
JWT_SECRET_PREVIOUS=

# --- Rate limiting (all values are optional, sensible defaults apply) ---
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000     # 15 minutes (default)
# RATE_LIMIT_GLOBAL_MAX=100              # requests per window per IP
# RATE_LIMIT_AUTH_WINDOW_MS=900000       # 15 minutes
# RATE_LIMIT_AUTH_MAX=10                 # auth endpoint limit per IP
# RATE_LIMIT_PUBLIC_READ_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_READ_MAX=60          # identity/asset lookup per IP
# RATE_LIMIT_VERIFY_WINDOW_MS=900000
# RATE_LIMIT_VERIFY_MAX=30              # verification endpoints per IP
# RATE_LIMIT_WRITE_WINDOW_MS=900000
# RATE_LIMIT_WRITE_MAX=20               # privileged writes per user
